# Puerto del servidor (por defecto 3000)
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=development

# Clave de API de Google Gemini (opcional pero recomendada para análisis con LLM)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=

# Correo electrónico del usuario para visualización (opcional)
USER_EMAIL=usuario@gmail.com
USER_NAME="Usuario Gmail"
