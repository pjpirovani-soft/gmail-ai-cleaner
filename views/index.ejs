<%- include('partials/header') %>

<main style="max-width: 1100px; margin: 0 auto; padding: 32px 24px;">

  <!-- Welcome / Intro Section (Material Design 3) -->
  <section class="md-card md-card-elevated-1" id="welcomeSection" style="margin-bottom: 24px; background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);">
    <div style="display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 6px; background-color: var(--md-primary-container); color: var(--md-on-primary-container); font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: var(--md-shape-full); margin-bottom: 12px;">
          <span class="material-symbols-outlined" style="font-size: 16px;">auto_awesome</span>
          <span>Potenciado con Gemini AI</span>
        </div>
        <h1 style="font-size: 28px; font-weight: 500; margin: 0 0 8px 0; color: var(--md-on-surface); letter-spacing: -0.3px;">
          Organiza tu bandeja de entrada con IA
        </h1>
        <p style="font-size: 15px; color: var(--md-on-surface-variant); margin: 0; max-width: 650px;">
          Usa la inteligencia artificial para clasificar y limpiar tus correos de forma segura, reduciendo el desorden digital en segundos.
        </p>
      </div>

      <!-- Quick Status Pill -->
      <div style="display: flex; align-items: center; gap: 8px; background: var(--md-surface); border: 1px solid var(--md-outline); padding: 8px 16px; border-radius: var(--md-shape-full); font-size: 13px; color: var(--md-on-surface);">
        <span style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--md-secondary); display: inline-block;"></span>
        <span>Modo Seguro: Vista previa y confirmación activa</span>
      </div>
    </div>

    <!-- Quick Filter Chips -->
    <div style="margin-top: 20px;">
      <span style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--md-on-surface-variant); display: block; margin-bottom: 8px;">
        Filtros rápidos recomendados:
      </span>
      <div class="md-chip-group">
        <button type="button" class="md-chip md-chip-filter" data-filter="older_than:1y" onclick="setFilter('older_than:1y')">
          <span class="material-symbols-outlined" style="color: var(--md-primary);">calendar_today</span>
          <span>📅 Correos antiguos</span>
        </button>
        <button type="button" class="md-chip md-chip-filter" data-filter="from:newsletter" onclick="setFilter('from:newsletter')">
          <span class="material-symbols-outlined" style="color: var(--md-tertiary-hover);">newspaper</span>
          <span>📰 Newsletters</span>
        </button>
        <button type="button" class="md-chip md-chip-filter" data-filter="larger:10M" onclick="setFilter('larger:10M')">
          <span class="material-symbols-outlined" style="color: var(--md-error);">attachment</span>
          <span>📎 Correos pesados (>10MB)</span>
        </button>
        <button type="button" class="md-chip md-chip-filter" data-filter="from:ofertas" onclick="setFilter('from:ofertas')">
          <span class="material-symbols-outlined" style="color: var(--md-secondary);">sell</span>
          <span>🏷️ Promociones caducadas</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Search & Analysis Card -->
  <section class="md-card md-card-elevated-1" id="searchCard" style="margin-bottom: 24px;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px;">
      <span class="material-symbols-outlined" style="color: var(--md-primary); font-size: 24px;">search</span>
      <h2 style="font-size: 18px; font-weight: 500; margin: 0; color: var(--md-on-surface);">
        Buscar y analizar correos
      </h2>
    </div>

    <form id="searchForm">
      <div style="display: grid; grid-template-columns: 1fr 140px auto; gap: 16px; align-items: flex-start;">
        <!-- Floating label search input -->
        <div class="md-text-field">
          <div class="md-input-wrapper">
            <input type="text" 
                   id="queryInput" 
                   name="query" 
                   placeholder=" " 
                   class="md-input" 
                   value="older_than:1y" 
                   autocomplete="off" 
                   required>
            <label for="queryInput" class="md-floating-label">Filtro de búsqueda (Gmail syntax)</label>
          </div>
          <div class="md-helper-text">
            <span class="material-symbols-outlined" style="font-size: 14px;">lightbulb</span>
            <span>Ejemplos: older_than:1y, from:newsletter, larger:10M</span>
          </div>
        </div>

        <!-- Limit input -->
        <div class="md-text-field">
          <div class="md-input-wrapper">
            <input type="number" 
                   id="limiteInput" 
                   name="limite" 
                   placeholder=" " 
                   class="md-input has-value" 
                   value="10" 
                   min="1" 
                   max="100" 
                   required>
            <label for="limiteInput" class="md-floating-label">Límite</label>
          </div>
          <div class="md-helper-text">
            <span>Máx. 100</span>
          </div>
        </div>

        <!-- Elevated Analyze Button -->
        <button type="submit" id="analizarBtn" class="md-btn md-btn-filled-primary" style="height: 52px; padding: 0 28px;">
          <span class="material-symbols-outlined" style="font-size: 20px;">smart_toy</span>
          <span>Analizar</span>
        </button>
      </div>
    </form>

    <!-- Linear Progress Bar (Material 3) -->
    <div class="md-progress-container" id="progressContainer">
      <div class="md-progress-header">
        <span id="progressText">Analizando correo 1 de 10 con Gemini...</span>
        <span style="color: var(--md-primary); font-weight: 600;">Procesando</span>
      </div>
      <div class="md-linear-progress">
        <div class="md-linear-progress-bar" id="progressBar" style="width: 25%;"></div>
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section id="resultadosContainer" class="hidden">
    
    <!-- Summary Indicator Cards (M3 Elevated Cards) -->
    <div class="md-summary-grid" id="summaryGrid">
      
      <!-- Card Red: Para Eliminar -->
      <div class="md-indicator-card red" id="cardEliminar">
        <div class="md-indicator-icon-wrapper">
          <span class="material-symbols-outlined">delete_sweep</span>
        </div>
        <div>
          <div class="md-indicator-value" id="badgeEliminar">0</div>
          <div class="md-indicator-label">Para eliminar</div>
        </div>
      </div>

      <!-- Card Yellow: Para Archivar -->
      <div class="md-indicator-card yellow" id="cardArchivar">
        <div class="md-indicator-icon-wrapper">
          <span class="material-symbols-outlined">archive</span>
        </div>
        <div>
          <div class="md-indicator-value" id="badgeArchivar">0</div>
          <div class="md-indicator-label">Para archivar</div>
        </div>
      </div>

      <!-- Card Green: Para Conservar -->
      <div class="md-indicator-card green" id="cardConservar">
        <div class="md-indicator-icon-wrapper">
          <span class="material-symbols-outlined">mark_email_read</span>
        </div>
        <div>
          <div class="md-indicator-value" id="badgeConservar">0</div>
          <div class="md-indicator-label">Para conservar</div>
        </div>
      </div>
    </div>

    <!-- Data Table Container (Material 3) -->
    <div class="md-table-container" id="tableContainer">
      <div style="padding: 18px 20px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--md-outline);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <h3 style="margin: 0; font-size: 16px; font-weight: 500; color: var(--md-on-surface);">
            Bandeja clasificada
          </h3>
          <span id="selectedCountText" style="font-size: 13px; color: var(--md-primary); font-weight: 500;"></span>
        </div>
        <div id="totalCorreosText" style="font-size: 13px; color: var(--md-on-surface-variant);"></div>
      </div>

      <!-- Table -->
      <div style="overflow-x: auto;">
        <table class="md-table" id="tablaCorreosTable">
          <thead>
            <tr>
              <th style="width: 44px; text-align: center;">
                <input type="checkbox" id="selectAllCheckbox" class="md-checkbox" aria-label="Seleccionar todos los correos">
              </th>
              <th>Asunto</th>
              <th>Remitente</th>
              <th>Recomendación</th>
              <th>Acción</th>
            </tr>
          </thead>
          <tbody id="tablaCorreos">
            <!-- Dynamic rows rendered by script.js -->
          </tbody>
        </table>
      </div>

      <!-- Pagination Bar -->
      <div class="md-pagination" id="paginationBar">
        <span>Filas por página:</span>
        <select id="pageSizeSelect" class="md-select" style="height: 28px; width: 60px; padding: 0 4px;">
          <option value="5" selected>5</option>
          <option value="10">10</option>
          <option value="25">25</option>
        </select>
        <span id="pageRangeText" style="margin-left: 12px;">1–5 de 10</span>
        <button type="button" id="prevPageBtn" class="md-pagination-btn" aria-label="Página anterior" disabled>
          <span class="material-symbols-outlined" style="font-size: 20px;">chevron_left</span>
        </button>
        <button type="button" id="nextPageBtn" class="md-pagination-btn" aria-label="Página siguiente">
          <span class="material-symbols-outlined" style="font-size: 20px;">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- Action Buttons Bar (Material 3 Elevated Buttons) -->
    <div class="md-actions-bar" id="actionsBar">
      <button type="button" id="btnEliminarSeleccionados" class="md-btn md-btn-filled-error" disabled>
        <span class="material-symbols-outlined">delete</span>
        <span>Eliminar seleccionados</span>
      </button>

      <button type="button" id="btnArchivarSeleccionados" class="md-btn md-btn-filled-tertiary" disabled>
        <span class="material-symbols-outlined">archive</span>
        <span>Archivar seleccionados</span>
      </button>

      <div style="flex-grow: 1;"></div>

      <button type="button" id="btnSimular" onclick="ejecutarLimpieza('simulacion')" class="md-btn md-btn-tonal">
        <span class="material-symbols-outlined">visibility</span>
        <span>Simular</span>
      </button>

      <button type="button" id="btnAutomatico" onclick="ejecutarLimpieza('automatico')" class="md-btn md-btn-filled-secondary">
        <span class="material-symbols-outlined">bolt</span>
        <span>Ejecutar automático</span>
      </button>

      <button type="button" id="btnInteractivo" onclick="ejecutarLimpieza('interactivo')" class="md-btn md-btn-filled-primary">
        <span class="material-symbols-outlined">published_with_changes</span>
        <span>Modo interactivo</span>
      </button>
    </div>

    <!-- Dynamic execution summary results container -->
    <div id="resultadosLimpieza"></div>

  </section>

</main>

<%- include('partials/footer') %>
