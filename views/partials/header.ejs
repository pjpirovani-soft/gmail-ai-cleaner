<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gmail AI Cleaner</title>
  <meta name="description" content="Analizador y limpiador inteligente de correos de Gmail con Google Material Design e Inteligencia Artificial">
  <meta property="og:title" content="Gmail AI Cleaner v2.0">
  <meta property="og:description" content="Organiza tu bandeja de entrada de Gmail con IA y diseño Material Design 3">

  <!-- Google Fonts: Roboto & Material Symbols Outlined -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

  <!-- Material Design 3 Stylesheet -->
  <link rel="stylesheet" href="/css/material.css">

  <!-- Progressive Web App (PWA) Manifest & Meta Tags -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#FFFFFF">
  <meta name="background-color" content="#F8F9FA">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="GmailCleaner">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="icon" type="image/svg+xml" href="/icons/icon.svg">
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192x192.png">
  <!-- Theme initialization script (prevents flash of unstyled theme) -->
  <script>
    (function() {
      try {
        const saved = localStorage.getItem('gmail_cleaner_theme') || 
          (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (saved === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>

  <!-- Google Material 3 App Bar -->
  <header class="md-app-bar" id="appBar">
    <a href="/" class="md-logo-badge" id="logoLink">
      <div class="md-logo-icon">
        <span class="material-symbols-outlined" style="font-size: 24px;">mail</span>
      </div>
      <div style="display: flex; align-items: center;">
        <span class="md-app-title">Gmail AI Cleaner</span>
        <span class="md-app-badge">v2.0 PWA</span>
      </div>
    </a>

    <!-- Header Actions (Install PWA, Dark Mode & User Profile) -->
    <div style="display: flex; align-items: center; gap: 8px;">
      <!-- Dark Mode Toggle Button -->
      <button id="themeToggleBtn" class="md-theme-toggle-btn ripple-surface" type="button" aria-label="Cambiar tema claro u oscuro" title="Cambiar a modo oscuro">
        <span class="material-symbols-outlined" id="themeToggleIcon" style="font-size: 20px;">dark_mode</span>
      </button>

      <!-- PWA Install Button (Dynamic Chromium/Android & iOS) -->
      <button id="pwaInstallBtn" class="md-btn md-btn-tonal ripple-surface" type="button" style="display: none; height: 38px; padding: 0 16px; border-radius: var(--md-shape-full); font-size: 13px;">
        <span class="material-symbols-outlined" style="font-size: 18px; color: var(--md-primary);">install_mobile</span>
        <span>Instalar App</span>
      </button>

      <!-- Offline Indicator Badge -->
      <div id="offlineBadge" style="display: none; align-items: center; gap: 6px; background-color: #FEEFC3; color: #7A4B04; padding: 6px 12px; border-radius: var(--md-shape-full); font-size: 12px; font-weight: 500;">
        <span class="material-symbols-outlined" style="font-size: 16px; color: #E37400;">cloud_off</span>
        <span>Sin conexión</span>
      </div>

      <!-- Google OAuth Connection / User Profile Menu -->
      <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
        <div style="display: flex; align-items: center; gap: 8px;">
          <!-- User Profile Dropdown Button -->
          <div class="md-menu-container">
            <button class="md-user-button ripple-surface" id="userMenuBtn" aria-label="Menú de usuario" type="button" title="Cuenta de <%= typeof userName !== 'undefined' && userName ? userName : 'Usuario' %>">
              <% if (typeof userAvatar !== 'undefined' && userAvatar) { %>
                <img src="<%= userAvatar %>" alt="Avatar" class="md-avatar" style="object-fit: cover;" referrerpolicy="no-referrer">
              <% } else { %>
                <div class="md-avatar"><%= typeof userName !== 'undefined' && userName ? userName.charAt(0).toUpperCase() : 'U' %></div>
              <% } %>
              <span class="md-user-name"><%= typeof userName !== 'undefined' && userName ? userName : 'Usuario' %></span>
              <span class="material-symbols-outlined" style="font-size: 18px; color: var(--md-on-surface-variant);">arrow_drop_down</span>
            </button>

            <!-- Dropdown Menu -->
            <div class="md-menu" id="userMenu">
              <div class="md-menu-header">
                <div class="md-menu-header-name"><%= typeof userName !== 'undefined' && userName ? userName : 'Usuario Conectado' %></div>
                <div class="md-menu-header-email"><%= typeof userEmail !== 'undefined' && userEmail ? userEmail : 'cuenta@gmail.com' %></div>
                <div style="margin-top: 6px; display: inline-flex; align-items: center; gap: 4px; font-size: 11px; color: #1e8e3e; font-weight: 500;">
                  <span class="material-symbols-outlined" style="font-size: 14px;">verified</span>
                  <span>Gmail OAuth 2.0 Conectado</span>
                </div>
              </div>
              <button class="md-menu-item" type="button" onclick="showSnackbar('Conectado a Gmail mediante OAuth 2.0', 'success')">
                <span class="material-symbols-outlined">shield_person</span>
                <span>Estado de cuenta: Activo</span>
              </button>
              <button class="md-menu-item" type="button" onclick="showSnackbar('Modelo de clasificación activo: Gemini 3.8 Flash', 'info')">
                <span class="material-symbols-outlined">psychology</span>
                <span>Modelo: Gemini 3.8 Flash</span>
              </button>
              <button class="md-menu-item" type="button" id="menuInstallPwaBtn" style="display: none;">
                <span class="material-symbols-outlined" style="color: var(--md-primary);">install_mobile</span>
                <span>Instalar PWA en celular</span>
              </button>
              <hr style="border: none; border-top: 1px solid var(--md-surface-container); margin: 4px 0;">
              <a href="/auth/logout" class="md-menu-item" id="menuLogoutBtn" style="color: var(--md-error); text-decoration: none; display: flex; align-items: center; gap: 8px;">
                <span class="material-symbols-outlined" style="color: var(--md-error);">logout</span>
                <span>Cerrar sesión</span>
              </a>
            </div>
          </div>

          <!-- Botón Cerrar Sesión directo en Header -->
          <a href="/auth/logout" id="headerLogoutBtn" class="md-btn ripple-surface" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 12px; border-radius: var(--md-shape-full); font-size: 13px; font-weight: 500; color: var(--md-error); background: rgba(234, 67, 53, 0.08); border: 1px solid rgba(234, 67, 53, 0.2);" title="Cerrar sesión">
            <span class="material-symbols-outlined" style="font-size: 18px; color: var(--md-error);">logout</span>
            <span>Cerrar sesión</span>
          </a>
        </div>
      <% } else { %>
        <!-- Botón Iniciar sesión con Google cuando no está autenticado -->
        <a href="/auth/google" id="headerGoogleLoginBtn" class="md-btn md-btn-filled-primary ripple-surface" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px; border-radius: var(--md-shape-full); font-size: 13px; font-weight: 500;">
          <svg style="width: 16px; height: 16px;" viewBox="0 0 24 24">
            <path fill="#ffffff" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#ffffff" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#ffffff" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#ffffff" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Iniciar sesión con Google</span>
        </a>
      <% } %>
    </div>
  </header>

  <!-- iOS Safari Add to Home Screen Instructions Modal -->
  <div id="iosInstallModal" class="md-modal-backdrop" style="display: none;">
    <div class="md-card md-card-elevated-3" style="max-width: 420px; width: 90%; margin: auto; padding: 24px; position: relative;">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
        <div class="md-logo-icon" style="width: 44px; height: 44px;">
          <span class="material-symbols-outlined" style="color: var(--md-primary); font-size: 26px;">phone_iphone</span>
        </div>
        <div>
          <h2 style="font-size: 18px; font-weight: 500; margin: 0; color: var(--md-on-surface);">Instalar en iPhone / iPad</h2>
          <span style="font-size: 13px; color: var(--md-on-surface-variant);">Safari en iOS</span>
        </div>
      </div>

      <p style="font-size: 14px; color: var(--md-on-surface-variant); line-height: 1.5; margin-bottom: 16px;">
        Para instalar <strong>Gmail AI Cleaner</strong> en tu dispositivo Apple sin pasar por la App Store:
      </p>

      <ol style="font-size: 14px; color: var(--md-on-surface); line-height: 1.8; margin-left: 20px; margin-bottom: 24px; padding-left: 0;">
        <li>Toca el botón <strong>Compartir</strong> <span class="material-symbols-outlined" style="vertical-align: middle; font-size: 18px;">ios_share</span> en la barra de Safari.</li>
        <li>Desplázate hacia abajo y selecciona <strong>"Agregar a pantalla de inicio"</strong>.</li>
        <li>Pulsa <strong>"Agregar"</strong> en la esquina superior derecha.</li>
      </ol>

      <div style="display: flex; justify-content: flex-end;">
        <button type="button" class="md-btn md-btn-filled-primary ripple-surface" onclick="closeIosInstallModal()">
          Entendido
        </button>
      </div>
    </div>
  </div>
