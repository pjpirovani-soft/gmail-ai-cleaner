<%- include('partials/header') %>

<main style="max-width: 1100px; margin: 0 auto; padding: 32px 24px;">
  <section class="md-card md-card-elevated-1" id="resultadosCard">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
      <span class="material-symbols-outlined" style="color: var(--md-primary); font-size: 28px;">insights</span>
      <h1 style="font-size: 22px; font-weight: 500; margin: 0; color: var(--md-on-surface);">
        Resultados de la limpieza
      </h1>
    </div>

    <div id="resultadosDetalle" style="padding: 24px; background: var(--md-surface-variant); border-radius: var(--md-shape-md); border: 1px solid var(--md-outline);">
      <p style="color: var(--md-on-surface-variant); margin: 0 0 16px 0;">
        Puedes regresar al panel principal para buscar y analizar correos en tu bandeja de entrada.
      </p>
      <a href="/" class="md-btn md-btn-filled-primary">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>Volver a la Bandeja Principal</span>
      </a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
